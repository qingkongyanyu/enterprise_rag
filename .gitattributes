* text=auto

# Source code: LF everywhere
*.py   text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.txt  text eol=lf

# Windows batch stays CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
