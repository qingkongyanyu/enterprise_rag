# ==========================================================
# enterprise_rag 环境变量模板
# 使用方式：复制本文件为 backend/.env（或项目根 .env）并填入真实值
#   cp .env.example backend/.env
# 注意：.env 已被 .gitignore 忽略，严禁把真实密钥提交到 Git。
# ==========================================================

# ---------- LLM（OpenAI 兼容接口，默认阿里云百炼 DashScope）----------
# 模型服务 Base URL。常见取值：
#   DashScope（通义千问）: https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:                https://api.openai.com/v1
#   本地 Ollama:           http://localhost:11434/v1
#   火山方舟（豆包）:      https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# API Key（DashScope 的 Key 以 sk- 开头）
LLM_API_KEY=your-api-key-here

# 模型名称
#   DashScope: qwen-turbo / qwen-plus / qwen-max
#   OpenAI:    gpt-4o-mini / gpt-4o
#   Ollama:    你本地已拉取的模型，如 qwen2.5:7b
#   火山方舟:  doubao-pro-32k 等（需先在控制台接入点获取模型 ID）
LLM_MODEL=qwen-turbo

# 生成参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ---------- 嵌入模型（sentence-transformers，首次运行自动下载）----------
# 国内网络可设置 HF_ENDPOINT=https://hf-mirror.com 加速下载
EMBEDDING_MODEL=BAAI/bge-small-zh

# ---------- 检索参数 ----------
# 混合检索：稠密（向量）+ 稀疏（BM25）各自召回数量
DENSE_TOP_K=8
SPARSE_TOP_K=8
# 最终返回给 LLM 的文档块数
FINAL_TOP_K=5
# 是否启用交叉编码器重排（True 会更准但更慢，CPU 环境建议 False）
ENABLE_RERANK=False
# 重排模型
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 重排后取前 N 个
RERANK_TOP_N=4

# ---------- 分块参数 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---------- 会话记忆 ----------
# 注入给 LLM 的最大历史对话轮数（1 轮 = 一问一答）
MAX_HISTORY_TURNS=6

# ---------- 服务 ----------
# 监听地址/端口（Docker 内默认 8000）
HOST=0.0.0.0
PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
